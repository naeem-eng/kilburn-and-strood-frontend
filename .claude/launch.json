{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "next-dev",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev"
      ],
      "port": 3000
    },
    {
      "name": "next-prod-local",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "next",
        "start",
        "-p",
        "3005"
      ],
      "port": 3005,
      "env": {
        "PROD_DOMAIN": "localhost:3005"
      }
    },
    {
      "name": "strapi-local",
      "runtimeExecutable": "sh",
      "runtimeArgs": [
        "-c",
        "cd ~/Desktop/ath/strapi/strapi && yarn develop"
      ],
      "port": 1337,
      "url": "http://localhost:1337"
    }
  ]
}